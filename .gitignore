# Python cache (lixo, recriado em qualquer máquina)
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# Ambientes virtuais (uv cria .venv automaticamente)
venv/
.venv/
env/
.env
.uv/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*~

# Configuracao local do Claude Code (permissoes aprovadas, hooks locais)
.claude/

# Dados intermediarios e features (reproduziveis via Projeto/codigo/01-04)
# Os parquets brutos em Projeto/Alterado/ continuam versionados
Projeto/dados/intermediarios/*.parquet
Projeto/dados/features/*.parquet

# Modelos treinados (reproduziveis via Projeto/codigo/05-08)
Projeto/modelos/*.pkl
Projeto/modelos/*.joblib
Projeto/modelos/*.lgb
Projeto/modelos/*.txt
